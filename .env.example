# Copy this file to .env and fill in what you have.
# Nothing here is required to run Research Hunter — connectors that need a
# missing key are just skipped automatically. But CONTACT_EMAIL is strongly
# recommended: several APIs (CrossRef, OpenAlex, SEC EDGAR, Unpaywall) rate-limit
# or block requests without an identifiable contact.

CONTACT_EMAIL=you@example.com

# Free, no approval wait: https://core.ac.uk/services/api
CORE_API_KEY=

# Free, instant: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional — raises your Semantic Scholar rate limit, works fine without it
# for normal research-session volume: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
